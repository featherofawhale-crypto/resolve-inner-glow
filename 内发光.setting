                        Left = Input { Value = 0, },
                        Bottom = Input { Value = 0, },
                        Right = Input { Value = 1, },
                        Top = Input { Value = 1, },
                        Brightness = Input { Value = 1.8, },
                        Radius = Input { Value = 16, },
                        Fill = Input { Value = 1, },
                        Core = Input { Value = 0.8, },
                        Detail = Input { Value = 0.08, },
                        HaloEnabled = Input { Value = 1, },
                        Halo = Input { Value = 1.5, },
                        HaloRadius = Input { Value = 65, },
                        UseCustomHaloColor = Input { Value = 0, },
                    },
                    UserControls = ordered() {
                        HaloEnabled = {
                            LINKS_Name = "启用外溢柔光", LINKID_DataType = "Number",
                            INPID_InputControl = "CheckboxControl", INP_Integer = true,
                            ICS_ControlPage = "Controls", INP_Default = 1,
                        },
                        Halo = {
                            LINKS_Name = "外溢柔光", LINKID_DataType = "Number",
                            INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls",
