                            INP_Default = 0.8, INP_MinScale = 0, INP_MaxScale = 1,
                            INP_MinAllowed = 0, INP_MaxAllowed = 1,
                        },
                        Detail = {
                            LINKS_Name = "纹理保留", LINKID_DataType = "Number",
                            INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls",
                            INP_Default = 0.08, INP_MinScale = 0, INP_MaxScale = 1,
                            INP_MinAllowed = 0, INP_MaxAllowed = 1,
                        },

                        Brightness = {
                            LINKS_Name = "亮度", LINKID_DataType = "Number",
                            INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls",
                            INP_Default = 1.8, INP_MinScale = 0, INP_MaxScale = 5,
                            INP_MinAllowed = 0, INP_MaxAllowed = 100,
                        },
                        Radius = {
                            LINKS_Name = "发光半径", LINKID_DataType = "Number",
                            INPID_InputControl = "SliderControl", ICS_ControlPage = "Controls",
                            INP_Default = 16, INP_MinScale = 0, INP_MaxScale = 100,
                            INP_MinAllowed = 0, INP_MaxAllowed = 500,
