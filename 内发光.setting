                    },
                    ViewInfo = OperatorInfo { Pos = { 0, 0 } },
                },
                InvertMatte = Custom {
                    Inputs = {
                        Image1 = Input { SourceOp = "AlphaDomain", Source = "Output", },
                        RedExpression = Input { Value = "1-min(max(a1,0),1)", },
